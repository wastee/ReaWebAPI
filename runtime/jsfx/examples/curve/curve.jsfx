desc:ReaWebAPI JSFX curve editor
options:gmem=ReaWebAPI_Demo_v1
import reaweb_jsfx.inc
slider1:1<0,1,0.001>Gain
slider2:0<-70368744177664,70368744177664,1>-ReaWebAPI transport v1
in_pin:left
in_pin:right
out_pin:left
out_pin:right
@init
ext_tail_size=-1;
reaweb_jsfx_init(0,65536);
reaweb_jsfx_state(0,1024,2048,5,32,1,0)==1 ? (
  1024[0]=4;1024[1]=0;1024[2]=0.33;1024[3]=0.67;1024[4]=1;
);
@slider
slider2=reaweb_jsfx_handshake(slider2);
@block
slider2=reaweb_jsfx_handshake(slider2);
reaweb_jsfx_service();
curve=reaweb_jsfx_state_data(0);
@sample
// The endpoint controls gain. The complete curve remains available to the DSP.
curve>=0 ? (spl0*=curve[4]*slider1;spl1*=curve[4]*slider1;);
@serialize
reaweb_jsfx_serialize(0,1,0);
slider2=reaweb_jsfx_handshake(slider2);
